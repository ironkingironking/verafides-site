{
  "name": "verafides-site",
  "private": true,
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "hugo-bin": "^0.149.2",
    "tailwindcss": "^3.4.0"
  },
  "scripts": {
    "dev": "hugo server --port 1313",
    "dev:hugo": "hugo server --port 1313",
    "tw:build": "tailwindcss -i ./assets/css/main.css -o ./static/css/main.css --minify",
    "tw:watch": "tailwindcss -i ./assets/css/main.css -o ./static/css/main.css --watch",
    "hugo:build": "node -r dotenv/config scripts/hugo-build.js",
    "build": "npm run tw:build && npm run hugo:build"
  }
}
