# ---- Contact / Mail delivery ----
# Optional: default is redaktion@verafides.ch
CONTACT_TO_EMAIL=redaktion@verafides.ch

# SMTP (mailcow on mail.verafides.ch)
SMTP_HOST=mail.verafides.ch
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@verafides.ch
SMTP_PASS=your_smtp_password
# Optional display name; defaults to "Verafides <SMTP_USER>"
SMTP_FROM="Verafides <noreply@verafides.ch>"

# Express API server port (default: 3001)
PORT=3001

# ---- Turnstile spam protection ----
# Frontend widget key (used by Hugo partial)
TURNSTILE_SITE_KEY=your_turnstile_site_key
# Backend verification secret (used by the Express API and Netlify fallback)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Uncomment only for local builds that intentionally omit Turnstile.
# VERAFIDES_REQUIRE_TURNSTILE=false

# ---- listmonk newsletter integration ----
LISTMONK_BASE_URL=http://127.0.0.1:9000
LISTMONK_API_USERNAME=your_listmonk_api_user
LISTMONK_API_TOKEN=your_listmonk_api_token

# Use one list UUID or a comma-separated list in LISTMONK_LIST_UUIDS
LISTMONK_LIST_UUID=your_list_uuid
# LISTMONK_LIST_UUIDS=uuid_a,uuid_b

# Numeric list ID (required for unsubscribe updates)
LISTMONK_LIST_ID=2

# ---- Decap CMS GitHub OAuth (for /admin on Vercel) ----
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
CMS_OAUTH_SECRET=generate_a_long_random_secret
# Optional override (must match GitHub OAuth callback URL exactly)
# CMS_OAUTH_REDIRECT_URL=https://verafides-site.vercel.app/api/cms/callback

# ---- Optional runtime context ----
# CONTEXT=production
# NODE_ENV=development

# ---- listmonk Docker runtime settings ----
LISTMONK_DB_NAME=listmonk
LISTMONK_DB_USER=listmonk
LISTMONK_DB_PASSWORD=your_listmonk_db_password
LISTMONK_DB_PORT=127.0.0.1:5432
LISTMONK_PORT=127.0.0.1:9000
LISTMONK_ADMIN_USER=admin@example.com
LISTMONK_ADMIN_PASSWORD=your_listmonk_admin_password
TZ=Europe/Zurich
