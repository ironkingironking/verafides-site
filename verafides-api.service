[Unit]
Description=Verafides API server (Express)
After=network.target

[Service]
Type=simple
User=alexadmin
Group=alexadmin
WorkingDirectory=/var/www/verafides
EnvironmentFile=/var/www/verafides/.env
ExecStart=/usr/bin/node api/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
